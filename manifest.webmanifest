{
  "name": "Dash Scratchpad",
  "short_name": "Scratchpad",
  "description": "Offline-first markdown scratchpad with one-click GitHub sync.",
  "start_url": "./scratchpad.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#0b0914",
  "background_color": "#0b0914",
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "New note",
      "url": "./scratchpad.html?new=1"
    }
  ]
}
